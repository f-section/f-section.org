---
import LangToggle from './LangToggle.astro';
import Tx from './Tx.astro';
import { t, href, basePath, type Lang, type UiKey } from '../i18n';

interface Props {
  lang: Lang;
  showToggle?: boolean;
}
const { lang, showToggle = true } = Astro.props;
const current = basePath(Astro.url.pathname);

const nav: { path: string; key: UiKey }[] = [
  { path: '/gallery/', key: 'nav.gallery' },
  { path: '/videos/', key: 'nav.videos' },
  { path: '/arivumalar/', key: 'nav.arivumalar' },
  { path: '/reunions/', key: 'nav.reunions' },
  { path: '/about/', key: 'nav.about' },
];
const isCurrent = (p: string) => current === p || current.startsWith(p);
// Tamil menu items are about twice as wide as English ones, so the inline menu needs more room.
const wide = lang === 'ta';
---
<header class="border-b-2 border-rule bg-paper">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-4 py-2 sm:gap-3">
    <a href={href(lang, '/')} class="hand tap shrink-0 whitespace-nowrap px-0 text-3xl text-ink no-underline sm:text-4xl"><Tx lang={lang} k="site.name" /></a>

    <nav class:list={['hidden', wide ? 'xl:block' : 'lg:block']} aria-label={t(lang, 'nav.main_label')}>
      <ul class="flex items-center gap-1">
        {
          nav.map((n) => (
            <li>
              <a
                href={href(lang, n.path)}
                class:list={['tap whitespace-nowrap rounded-md text-ink no-underline hover:bg-ink/10', isCurrent(n.path) && 'underline decoration-ink-red decoration-2']}
                aria-current={isCurrent(n.path) ? 'page' : undefined}
              >
                <Tx lang={lang} k={n.key} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {showToggle && <LangToggle lang={lang} />}
      <details class:list={['relative', wide ? 'xl:hidden' : 'lg:hidden']}>
        <summary class="tap cursor-pointer list-none gap-2 rounded-md border-2 border-ink/80 font-semibold [&::-webkit-details-marker]:hidden">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
          <Tx lang={lang} k="nav.menu" class="sr-only sm:not-sr-only" />
        </summary>
        <nav class="absolute right-0 z-20 mt-2 w-60 rounded-md border-2 border-rule bg-card p-2 shadow-lg" aria-label={t(lang, 'nav.main_label')}>
          <ul>
            <li>
              <a href={href(lang, '/')} class="tap w-full justify-start text-ink no-underline hover:bg-ink/10">
                <Tx lang={lang} k="nav.home" />
              </a>
            </li>
            {
              nav.map((n) => (
                <li>
                  <a
                    href={href(lang, n.path)}
                    class="tap w-full justify-start text-ink no-underline hover:bg-ink/10"
                    aria-current={isCurrent(n.path) ? 'page' : undefined}
                  >
                    <Tx lang={lang} k={n.key} />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

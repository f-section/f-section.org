---
/** நகைச்சுவை(யா?): each joke is a line of scene-setting, then the two of them talking. */
interface Props {
  jokes: { setup: string; lines: { speaker: string; text: string }[] }[];
}
const { jokes } = Astro.props;
---
<div class="max-w-prose">
  {
    jokes.map((joke) => (
      <div class="mt-8 border-t border-rule/60 pt-4 first:mt-0 first:border-0 first:pt-0">
        {joke.setup && <p class="text-sepia">{joke.setup}</p>}
        <dl class="mt-2">
          {joke.lines.map((line) => (
            <div class="mt-3 sm:flex sm:gap-3">
              <dt class="shrink-0 font-semibold text-ink-red sm:w-32 sm:text-right">{line.speaker}</dt>
              <dd class="min-w-0">{line.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</div>

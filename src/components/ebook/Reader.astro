---
/**
 * The frame around one reading page of the e-book: a பொருளடக்கம் button at the top, the
 * contents behind it, and prev · next at both ends -- at the top as two short labels, at
 * the end with the titles they lead to. A long piece used to mean scrolling all the way
 * down to turn the page (Saran, 2026-11-03). The reading column has the screen to
 * itself at every width (Saran, 2026-10-31): a list of 27 titles standing permanently
 * beside the text took the eye off the page it was there to serve.
 *
 * With JavaScript off the button is an ordinary link to the issue page, where the
 * contents are a real list, so nothing is lost.
 */
import Contents from './Contents.astro';
import Lightbox from '../Lightbox.astro';
import Tx from '../Tx.astro';
import { t, type Lang } from '../../i18n';
import { issueHref, sectionHref, words, type Issue, type Section } from '../../lib/arivumalar';

interface Props {
  lang: Lang;
  issue: Issue;
  sections: Section[];
  section: Section;
}
const { lang, issue, sections, section } = Astro.props;
const at = sections.findIndex((s) => s.data.slug === section.data.slug);
const prev = sections[at - 1];
const next = sections[at + 1];
const link = 'tap max-w-[45%] items-start gap-1 rounded-md px-2 py-2 leading-snug no-underline hover:bg-ink/5';
const step = 'tap rounded-md px-2 font-semibold no-underline hover:bg-ink/5';
---
<div class="flex items-center justify-between gap-2">
  <a href={issueHref(lang, issue)} class="tap -ml-3 font-semibold">
    <span>← <Tx lang={lang} k="ebook.back_to_issue" /></span>
  </a>
  <a
    href={`${issueHref(lang, issue)}#contents`}
    data-contents-open
    class="tap rounded-md border-2 border-ink/80 font-semibold no-underline text-ink"
  >
    <Tx lang={lang} k="ebook.contents" />
  </a>
</div>

<nav class="mt-2 flex items-center justify-between gap-2 border-y-2 border-rule" aria-label={t(lang, 'ebook.page_nav')}>
  {
    prev ? (
      <a href={sectionHref(lang, issue, prev)} class={`${step} -ml-2`} rel="prev">
        <span>← <Tx lang={lang} k="ebook.prev" /></span>
      </a>
    ) : (
      <span />
    )
  }
  {
    next ? (
      <a href={sectionHref(lang, issue, next)} class={`${step} -mr-2`} rel="next">
        <span><Tx lang={lang} k="ebook.next" /> →</span>
      </a>
    ) : (
      <span />
    )
  }
</nav>

<div class="mt-4">
  <div class="min-w-0">
    <slot />

    <nav class="mt-10 flex items-start justify-between gap-2 border-t-2 border-rule pt-3" aria-label={t(lang, 'ebook.page_nav')}>
      {
        prev ? (
          <a href={sectionHref(lang, issue, prev)} class={`${link} -ml-2`} rel="prev">
            <span>
              <span class="block text-base text-sepia">← <Tx lang={lang} k="ebook.prev" /></span>
              {words(prev.data.title, lang)}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={sectionHref(lang, issue, next)} class={`${link} -mr-2 text-right`} rel="next">
            <span>
              <span class="block text-base text-sepia"><Tx lang={lang} k="ebook.next" /> →</span>
              {words(next.data.title, lang)}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </div>
</div>

<dialog
  data-contents
  aria-label={t(lang, 'ebook.contents')}
  class="m-0 h-full max-h-none w-full max-w-none bg-paper p-0 text-ink backdrop:bg-ink/60"
>
  <div class="flex h-full flex-col">
    <div class="flex shrink-0 items-center justify-between border-b-2 border-rule px-2 pt-[env(safe-area-inset-top)]">
      <p class="px-2 text-base font-semibold uppercase tracking-wider text-sepia">
        <Tx lang={lang} k="ebook.contents" />
      </p>
      <button type="button" data-contents-close class="tap rounded-full hover:bg-ink/10" aria-label={t(lang, 'lightbox.close')}>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-[env(safe-area-inset-bottom)]">
      <Contents lang={lang} issue={issue} sections={sections} current={section.data.slug} />
    </div>
  </div>
</dialog>

<Lightbox lang={lang} />

<script>
  const panel = document.querySelector<HTMLDialogElement>('dialog[data-contents]');
  const button = document.querySelector<HTMLAnchorElement>('[data-contents-open]');

  if (panel && button && typeof panel.showModal === 'function') {
    button.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      panel.showModal();
      document.documentElement.style.overflow = 'hidden';
      panel.querySelector<HTMLAnchorElement>('a[aria-current="page"], a')?.focus();
    });
    panel.querySelector('[data-contents-close]')?.addEventListener('click', () => panel.close());
    panel.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      button.focus();
    });
  }
</script>

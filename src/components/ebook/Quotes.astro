---
/**
 * சொல்ல மறந்த கதை: a closing word from each person. The name links to their profile
 * page when they have one, so the two spreads of the book stay joined up.
 */
import { personHref, type Issue, type Person } from '../../lib/arivumalar';
import { type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  issue: Issue;
  people: Person[];
  quotes: { text: string; by: string; printed_by: string }[];
}
const { lang, issue, people, quotes } = Astro.props;
const byName = new Map(people.map((p) => [p.data.name.ta, p]));
---
<div class="max-w-prose">
  {
    quotes.map((quote) => {
      const person = byName.get(quote.by);
      return (
        <figure class="mt-8 border-l-4 border-rule pl-4 first:mt-0">
          <blockquote>{quote.text}</blockquote>
          {quote.by && (
            <figcaption class="mt-2 text-sepia">
              —{' '}
              {person ? (
                <a href={personHref(lang, issue, person)}>{quote.by}</a>
              ) : (
                <span class="font-semibold">{quote.by}</span>
              )}
            </figcaption>
          )}
        </figure>
      );
    })
  }
</div>
